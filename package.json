{
  "name": "study",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "redis": "redis-server redis/redis.conf --dir redis/data",
    "redis:cli": "redis-cli -p 6379",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "redis:docker": "docker compose up -d redis",
    "redis:docker:down": "docker compose down",
    "k8s:cluster": "kind create cluster --name study --wait 120s",
    "k8s:cluster:down": "kind delete cluster --name study",
    "k8s:up": "kubectl kustomize --load-restrictor LoadRestrictionsNone k8s | kubectl apply -f - && kubectl -n study rollout status statefulset/redis --timeout=120s",
    "k8s:down": "kubectl kustomize --load-restrictor LoadRestrictionsNone k8s | kubectl delete --ignore-not-found -f -",
    "k8s:port": "kubectl -n study port-forward svc/redis 6379:6379"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "ioredis": "^6.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.9"
}
