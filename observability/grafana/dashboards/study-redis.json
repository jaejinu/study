{
 "uid": "study-redis",
 "title": "Study · Redis + 앱 (메트릭·로그·트레이스)",
 "tags": [
  "study"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "명령 처리량 (ops/sec)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(redis_commands_processed_total[1m])",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "메모리 사용량",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "redis_memory_used_bytes",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "연결된 클라이언트",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "redis_connected_clients",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "키스페이스 히트율",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(redis_keyspace_hits_total[1m]) / (rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m]))",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "명령별 호출 (상위)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(8, rate(redis_commands_total[1m]))",
     "legendFormat": "{{cmd}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Study 앱: 읽은 노트 수",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "study_progress_read_total",
     "legendFormat": "{{subject}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Study 앱: 성공한 실험 수",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "study_progress_lab_total",
     "legendFormat": "{{subject}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "type": "logs",
   "title": "Study 앱 로그 (Loki)",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"study-app\"} | json",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "앱 요청 지연 p95 (Tempo span-metrics → Prometheus)",
   "gridPos": {
    "x": 0,
    "y": 42,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"study-app\", span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
     "legendFormat": "{{span_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "앱 요청 수 (span-metrics)",
   "gridPos": {
    "x": 12,
    "y": 42,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"study-app\", span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
     "legendFormat": "{{span_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "앱 액션 요청률 (Rate)",
   "gridPos": {
    "x": 0,
    "y": 50,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (action) (rate(study_action_duration_seconds_count[5m]))",
     "legendFormat": "{{action}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "앱 액션 에러율 (Errors)",
   "gridPos": {
    "x": 12,
    "y": 50,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (action) (rate(study_action_duration_seconds_count{outcome!=\"ok\"}[5m])) / sum by (action) (rate(study_action_duration_seconds_count[5m]))",
     "legendFormat": "{{action}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "앱 액션 p95 (Duration)",
   "gridPos": {
    "x": 0,
    "y": 58,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, action) (rate(study_action_duration_seconds_bucket[5m])))",
     "legendFormat": "{{action}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "실험 실행 (주제·결과)",
   "gridPos": {
    "x": 12,
    "y": 58,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (subject, outcome) (increase(study_experiment_runs_total[15m]))",
     "legendFormat": "{{subject}} {{outcome}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "노트 조회 (주제)",
   "gridPos": {
